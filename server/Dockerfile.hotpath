# hotpath: горячие коллекции (чат, воспоминания, пары…) поверх Postgres.
FROM python:3.12-slim
RUN pip install --no-cache-dir \
      "asyncpg>=0.29" "httpx>=0.27" "orjson>=3.10" "fastapi>=0.110" \
      "uvicorn>=0.29" "uvloop>=0.19" "httptools>=0.6"
WORKDIR /opt/hotpath
COPY pocketbase/hotpath/ /opt/hotpath/
CMD ["python", "hotpath.py"]
